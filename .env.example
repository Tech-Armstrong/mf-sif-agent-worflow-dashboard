# Composio: https://platform.composio.dev -> Settings -> API Keys
COMPOSIO_API_KEY=

# Toolkits the agent may use (comma-separated Composio slugs)
COMPOSIO_TOOLKITS=gmail,googledrive

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
OPENAI_API_VERSION=2024-10-21

# Web UI (python -m app.server)
AGENT_USER_ID=techops
# UPLOAD_DIR=./uploads
# MAX_UPLOAD_MB=100   # files over 5 MB use Drive resumable (chunked) upload

# Azure storage for uploaded files + parsed JSON (unset = local ./archive folder)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONTAINER=mf-documents

# Parsers: inline (a thread in this app, default) or queue (Azure Container Apps Jobs, see README)
# PARSE_RUNNER=inline
# Factsheets need docling: locally, a Python that has it (e.g. the Historical-Scheme-Portfolio venv)
# FACTSHEET_PYTHON=C:\path\to\Historical-Scheme-Portfolio\venv\Scripts\python.exe
# FACTSHEET_DEPLOYMENT=gpt-5-mini   # Azure OpenAI deployment for the factsheet agent (default AZURE_OPENAI_DEPLOYMENT)
